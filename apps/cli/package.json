{
  "name": "@llman-sdd/cli",
  "version": "0.3.0",
  "description": "Spec-driven development workflow CLI (the `llman-sdd` command)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/StrayDragon/llman-sdd.git",
    "directory": "apps/cli"
  },
  "bin": {
    "llman-sdd": "./src/main.ts"
  },
  "files": [
    "src"
  ],
  "type": "module",
  "exports": {
    ".": "./src/main.ts"
  },
  "scripts": {
    "lint": "bun run --cwd ../.. lint",
    "lint:fix": "bun run --cwd ../.. lint:fix",
    "format:check": "bun run --cwd ../.. format:check",
    "format:write": "bun run --cwd ../.. format:write",
    "typecheck": "bun run --cwd ../.. typecheck",
    "build": "bun run ./scripts/build-binary.ts"
  },
  "dependencies": {
    "@llman-sdd/core": "workspace:*",
    "commander": "^15.0.0"
  },
  "engines": {
    "bun": ">=1.4.0",
    "node": ">=24.0.0"
  }
}
