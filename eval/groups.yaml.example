# Generated by `bun eval/render-groups-example.ts` (SSOT: eval/groups-schema.ts).
# Do not hand-edit this file; change EXAMPLE_DOC / FILL_* and regenerate.
#
# Before a real Pi run:
#   1. cp eval/groups.yaml.example eval/groups.yaml
#   2. Replace every FILL token. Empty worktree = this llman-sdd checkout.
#   3. Extra groups (e.g. experiment) are optional; omit them for a single-group run.
#   4. eval/groups.yaml is gitignored.
#   5. just eval          # default agent is Pi; missing FILL/docker/harbor → non-zero (not skip)
#   6. just eval oracle   # no LLM; calibrates assertions only
#
# Pi in Docker (auto-injected; do not rely on Harbor's thin model_api overlay):
#   just eval writes models.json (api: openai-responses, provider fusionsparks)
#   and mounts it RO at /opt/pi-seed (Harbor mounts are RO-only);
#   wrapper copies it to writable /tmp/pi-config so Pi can write auth.json.
#   Bare model ids become fusionsparks/<id>. Default --thinking is max (0731).
#   openai_base_url is written into models.json only — not exported as OPENAI_BASE_URL
#   (that would make Harbor overwrite models.json with harbor-endpoint).
#
# pi:                         # optional; defaults shown
#   provider: fusionsparks
#   api: openai-responses
#   thinking: max
#
n_attempts: 1
baseline: stable
model: FILL-vllm-model
openai_base_url: http://FILL-vllm-host:8000/v1
groups:
  stable:
    worktree:    # empty = current repo
  # experiment:  # optional; uncomment to compare against baseline
  #   worktree: /FILL/worktree-b
  # A/B style contrast (eval-playbook r98): stable = baseline-template checkout,
  # the other group = style-revised branch checkout; n_attempts >= 3 each,
  # compare rollup.exitByGroup; skill_style criterion is observe-only
  # (/logs/verifier/skill-style.txt).
  # Secrets never committed: export ZAI_CODING_CN_API_KEY (or OPENAI_API_KEY) in
  # the host env and pass via harbor --env-file; write "apiKey": "$VAR" references
  # in models.json (Pi native interpolation); literals only in gitignored
  # groups.yaml / env. See eval-groups-schema PI_* constants.
  # stc-style:
  #   worktree: /FILL/worktree-b
