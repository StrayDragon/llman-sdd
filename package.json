{
  "name": "llman-sdd",
  "version": "0.4.0",
  "private": true,
  "description": "Spec-driven development workflow for LLM agent collaboration",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format:check": "oxfmt --check",
    "format:write": "oxfmt --write",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests/",
    "build": "bun --filter '@llman-sdd/cli' build",
    "check": "bun run typecheck && bun run lint && bun run format:check",
    "qa": "bun run check && bun run test && bun run check:skills-template-render && bun run pending-gate && bun run check:schema",
    "generate:skills-template-baseline": "bun tests/golden/generate.ts",
    "check:skills-template-render": "bun tests/golden/check.ts",
    "pending-gate": "bun scripts/pending-gate.ts",
    "gen:schema": "bun scripts/gen-schema.ts",
    "check:schema": "bun scripts/gen-schema.ts --check",
    "smoke:context": "bun scripts/smoke-context.ts"
  },
  "dependencies": {
    "nunjucks": "^3.2.4"
  },
  "devDependencies": {
    "7z-wasm": "^1.2.0",
    "@cucumber/gherkin": "^42.0.1",
    "@cucumber/messages": "^34.2.1",
    "@llman-sdd/core": "workspace:*",
    "@toon-format/toon": "^4.1.1",
    "@types/bun": "^1.4.2",
    "@types/nunjucks": "^3.2.6",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "typescript": "^7.0.2",
    "zod": "^4.6.5"
  },
  "engines": {
    "bun": ">=1.4.0",
    "node": ">=24.0.0"
  }
}
